--Aggregate order items (total value per order)
-- Step 1: Aggregate order items (total value per order)
WITH order_items_agg AS (
    SELECT 
        ["order_id"],
        SUM(CAST(["price"] AS FLOAT) + CAST(["freight_value"] AS FLOAT)) AS total_order_value
    FROM olist_order_items_dataset
    GROUP BY ["order_id"]
),

-- Step 2: Aggregate payments (total payment per order)
payments_agg AS (
    SELECT 
        ["order_id"],
        SUM(CAST(["payment_value"] AS FLOAT)) AS total_payment
    FROM olist_order_payments_dataset
    GROUP BY ["order_id"]
)

-- Step 3: Join everything cleanly
--Fix null values by updating my joins query
SELECT 
    c.["customer_unique_id"],
    o.["order_id"],
    CAST(o.["order_purchase_timestamp"] AS DATE) AS order_date,
   ISNULL(oi.total_order_value, 0) AS total_order_value,
    ISNULL(p.total_payment, 0) AS total_payment

FROM olist_orders_dataset o

INNER JOIN olist_customers_dataset c 
    ON o.["customer_id"] = c.["customer_id"]

LEFT JOIN order_items_agg oi 
    ON o.["order_id"] = oi.["order_id"]

LEFT JOIN payments_agg p 
    ON o.["order_id"] = p.["order_id"];

--Create a table with the joined data
WITH order_items_agg AS (
    SELECT 
        ["order_id"],
        SUM(CAST(["price"] AS FLOAT) + CAST(["freight_value"] AS FLOAT)) AS total_order_value
    FROM olist_order_items_dataset
    GROUP BY ["order_id"]
),

payments_agg AS (
    SELECT 
        ["order_id"],
        SUM(CAST(["payment_value"] AS FLOAT)) AS total_payment
    FROM olist_order_payments_dataset
    GROUP BY ["order_id"]
)

SELECT 
    c.["customer_unique_id"],
    o.["order_id"],
    CAST(o.["order_purchase_timestamp"] AS DATE) AS order_date,
    ISNULL(oi.total_order_value, 0) AS total_order_value,
    ISNULL(p.total_payment, 0) AS total_payment

INTO ecommerce_base

FROM olist_orders_dataset o

INNER JOIN olist_customers_dataset c 
    ON o.["customer_id"] = c.["customer_id"]

LEFT JOIN order_items_agg oi 
    ON o.["order_id"] = oi.["order_id"]

LEFT JOIN payments_agg p 
    ON o.["order_id"] = p.["order_id"];

