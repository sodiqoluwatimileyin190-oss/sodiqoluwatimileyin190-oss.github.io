--CUSTOMER METRIC (CORE ANALYSIS)
--Custmer summary metrics: 
WITH customer_metrics AS (
    SELECT 
        ["customer_unique_id"],
        COUNT(["order_id"]) AS total_orders,
        SUM(total_payment) AS total_spent,
        MAX(order_date) AS last_purchase_date
    FROM ecommerce_base
    GROUP BY ["customer_unique_id"]
)

SELECT top 50 *
FROM customer_metrics;

SELECT COUNT(DISTINCT ["customer_unique_id"]) AS total_customers
FROM ecommerce_base;

--RECENCY(How long since last purchase)
WITH customer_metrics AS (
    SELECT 
        ["customer_unique_id"],
        COUNT(["order_id"]) AS total_orders,
        SUM(total_payment) AS total_spent,
        MAX(order_date) AS last_purchase_date
    FROM ecommerce_base
    GROUP BY ["customer_unique_id"]
),

final_metrics AS (
    SELECT *,
        DATEDIFF(DAY, last_purchase_date, 
            (SELECT MAX(order_date) FROM ecommerce_base)
        ) AS recency
    FROM customer_metrics
)

SELECT *
FROM final_metrics;

--Defining Churn
WITH customer_metrics AS (
    SELECT 
        ["customer_unique_id"],
        COUNT(["order_id"]) AS total_orders,
        SUM(total_payment) AS total_spent,
        MAX(order_date) AS last_purchase_date
    FROM ecommerce_base
    GROUP BY ["customer_unique_id"]
),

final_metrics AS (
    SELECT *,
        DATEDIFF(DAY, last_purchase_date, 
            (SELECT MAX(order_date) FROM ecommerce_base)
        ) AS recency
    FROM customer_metrics
)

SELECT *,
    CASE 
        WHEN recency > 90 THEN 'Churned'
        ELSE 'Active'
    END AS customer_status
INTO churn_table
FROM final_metrics;

--Defining Distribution of Churned vs Active Customers
SELECT 
    customer_status,
    COUNT(*) 
FROM churn_table
GROUP BY customer_status;


