--PRODUCT ANALYSIS (What are customers buying, and does it relate to churn?)
--product view
SELECT 
    c.["customer_unique_id"],
    ct.customer_status,
    oi.["product_id"],
    p.["product_category_name"],
    oi.["price"]

FROM churn_table ct

INNER JOIN olist_customers_dataset c 
    ON ct.["customer_unique_id"] = c.["customer_unique_id"]

INNER JOIN olist_orders_dataset o 
    ON c.["customer_id"] = o.["customer_id"]

INNER JOIN olist_order_items_dataset oi 
    ON o.["order_id"] = oi.["order_id"]

LEFT JOIN olist_products_dataset p 
    ON oi.["product_id"] = p.["product_id"];


--We can use this view to analyze the relationship between customer churn and the products that customers are buying. For example, we can look at the distribution of product categories among churned vs active customers, or we can look at the average price of products purchased by churned vs active customers. This analysis can help us identify any patterns or trends in customer behavior that may be related to churn, and it can also help us identify any specific products or product categories that may be more likely to lead to churn.
    SELECT 
    customer_status,
    ["product_category_name"],
    COUNT(*) AS total_purchases
FROM (
    SELECT 
        c.["customer_unique_id"],
        ct.customer_status,
        oi.["product_id"],
        p.["product_category_name"]
    FROM churn_table ct
    INNER JOIN olist_customers_dataset c 
        ON ct.["customer_unique_id"] = c.["customer_unique_id"]
    INNER JOIN olist_orders_dataset o 
        ON c.["customer_id"] = o.["customer_id"]
    INNER JOIN olist_order_items_dataset oi 
        ON o.["order_id"] = oi.["order_id"]
    LEFT JOIN olist_products_dataset p 
        ON oi.["product_id"] = p.["product_id"]
) AS data
GROUP BY customer_status, ["product_category_name"]
ORDER BY total_purchases DESC;

--TOP PRODUCTS FOR CHURNED CUSTOMERS
SELECT TOP 10
  ["product_category_name"],
    COUNT(*) AS total_purchases
FROM (
    SELECT 
        ct.customer_status,
        p.["product_category_name"]
    FROM churn_table ct
    INNER JOIN olist_customers_dataset c 
        ON ct.["customer_unique_id"] = c.["customer_unique_id"]
    INNER JOIN olist_orders_dataset o 
        ON c.["customer_id"] = o.["customer_id"]
    INNER JOIN olist_order_items_dataset oi 
        ON o.["order_id"] = oi.["order_id"]
    LEFT JOIN olist_products_dataset p 
        ON oi.["product_id"] = p.["product_id"]
    WHERE ct.customer_status = 'Churned'
) AS churn_data
GROUP BY ["product_category_name"]
ORDER BY total_purchases DESC;

--TOP PRODUCTS FOR ACTIVE CUSTOMERS
SELECT TOP 10
  ["product_category_name"],
    COUNT(*) AS total_purchases
    FROM (
    SELECT 
        ct.customer_status,
        p.["product_category_name"]
        FROM churn_table ct
        INNER JOIN olist_customers_dataset c
        ON ct.["customer_unique_id"] = c.["customer_unique_id"]
        INNER JOIN olist_orders_dataset o
        ON c.["customer_id"] = o.["customer_id"]
        INNER JOIN olist_order_items_dataset oi
        ON o.["order_id"] = oi.["order_id"]
        LEFT JOIN olist_products_dataset p
        ON oi.["product_id"] = p.["product_id"]
        WHERE ct.customer_status = 'Active'
        ) AS active_data
        GROUP BY ["product_category_name"]
        ORDER BY total_purchases DESC;


